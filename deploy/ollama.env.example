# Settings for the Ollama service. Copy to ollama.env (git-ignored).
# Values are plain text: do not quote them. No secret is needed.

# Only one model is in memory at a time and one request at a time (ADR-0002).
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# How long a model stays in memory after its last request.
OLLAMA_KEEP_ALIVE=5m
# Image to run. Pin a tested version here, for example ollama/ollama:0.12.6.
OLLAMA_IMAGE=ollama/ollama:latest
# Name of the internal Docker network of the NFHotel web application and API
# (read by the compose file; keep it equal to benchmark.env).
NFHOTEL_API_NETWORK=nfhotel-api
