# Settings for the benchmark service. Copy to benchmark.env (git-ignored).
# Values are plain text: do not quote them. Make each token with: openssl rand -hex 32

# Token that callers (the NFHotel web application) must send to this service. The web
# application holds the same value in its own env file.
NFBENCH_API_TOKEN=change-me
# Address of the NFHotel API on the shared internal network, and its service token
# (the API token of NFHotel ADR-0004). The value is a different secret from the one above.
NFBENCH_WEB_URL=http://nfhotel-api:8080
NFBENCH_WEB_TOKEN=change-me
# The Ollama of NFHotel on the network nfhotel-llm (ADR-0004); change only to use another server.
NFBENCH_OLLAMA_URL=http://ollama:11434
# Dataset inside the image (synthetic). A real dataset is mounted and named here.
NFBENCH_DATASET=/app/data/example/synthetic_hotel_bookings.csv
# Where results and unsent results are kept (the volume results).
NFBENCH_DATA_DIR=/data

# Names of the Docker networks that NFHotel makes. Compose reads them from this file.
NFHOTEL_API_NETWORK=nfhotel-api
NFHOTEL_LLM_NETWORK=nfhotel-llm
